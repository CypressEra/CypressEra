# ============================================================
# CHAT MODEL CONFIGURATION
# ============================================================
# Used for: AI chat responses and function calling
# 
# Option 1: OpenAI (original)
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_MODEL=gpt-4o-mini
# (no OPENAI_BASE_URL needed for OpenAI)
#
# Option 2: Tencent Coding API
# OPENAI_API_KEY=sk-sp-xxx
# OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3
# OPENAI_MODEL=glm-5

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ============================================================
# EMBEDDING MODEL CONFIGURATION (for RAG)
# ============================================================
# Used for: Knowledge base vector embeddings (RAG retrieval)
# NOTE: Embedding can use a DIFFERENT provider than chat model
#
# Option 1: OpenAI Embeddings (recommended for best quality)
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_API_KEY=your_openai_api_key_here
# (no KB_EMBEDDING_BASE_URL needed for OpenAI)
#
# Option 2: Tencent Coding API Embeddings (if supported)
# KB_EMBEDDING_MODEL=text-embedding-3-small
# KB_EMBEDDING_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3
# KB_EMBEDDING_API_KEY=sk-sp-xxx  # Falls back to OPENAI_API_KEY if not set

# ============================================================
# KNOWLEDGE BASE SETTINGS
# ============================================================
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=3
# KB_BASE_PATH can be relative (for development) or absolute (for production)
# Relative: ../user-data/knowledge (relative to mcp-server directory)
# Absolute: /var/app/user-data/knowledge (for production deployment)
KB_BASE_PATH=../user-data/knowledge
KB_ENABLE_FILE_WATCHER=true

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3001
APP_ENV=development

# JWT Secret (must match api-server)
AUTH_JWT_SECRET=some-long-random-secret

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=simple
ENABLE_REQUEST_LOGGING=true

# ============================================================
# BRAIN MODULE CONFIGURATION
# ============================================================
# When enabled, ALL chat requests route through BrainEngine (dynamic tool loop).
# ENABLE_BRAIN=true
# BRAIN_MAX_ROUNDS=50
# BRAIN_MAX_TOKENS=100000
