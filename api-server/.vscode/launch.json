{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/src"
        },
        {
            "name": "Debug Go API Server (Frontend Ready)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/src/main.go",
            "env": {
                "API_SERVER_URL": "http://localhost:8080",
                "CORS_ALLOWED_ORIGINS": "*"
            },
            "args": [],
            "showLog": true,
            "trace": "verbose",
            "logOutput": "rpc",
            "console": "integratedTerminal"
        }
    ]
}