# ============================================================
# CHAT MODEL CONFIGURATION
# ============================================================
# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Option 2: Tencent Coding API
# OPENAI_API_KEY=your-tencent-api-key
# OPENAI_BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3
# OPENAI_MODEL=glm-4

# ============================================================
# EMBEDDING MODEL CONFIGURATION (for RAG)
# ============================================================
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_API_KEY=your-openai-api-key
KB_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ============================================================
# KNOWLEDGE BASE SETTINGS
# ============================================================
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=3
KB_BASE_PATH=../user-data/knowledge
KB_ENABLE_FILE_WATCHER=true

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3001
APP_ENV=development

# JWT Secret (must match api-server)
AUTH_JWT_SECRET=your-jwt-secret-here

# Service Authentication (for direct API-Server calls)
SERVICE_AUTH_ENABLED=true
SERVICE_AUTH_SECRET=your-service-auth-secret-here
API_SERVER_URL=http://localhost:8080

# Default User Context (for headless mode, optional)
# DEFAULT_USER_ID=

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=simple
ENABLE_REQUEST_LOGGING=true

# ============================================================
# SUPERVISOR MODE CONFIGURATION
# ============================================================
ENABLE_SUPERVISOR_MODE=true
SUPERVISOR_COMPLEXITY_THRESHOLD=20
SUPERVISOR_MAX_RETRIES=3
SUPERVISOR_PLANNING_TIMEOUT=10000
