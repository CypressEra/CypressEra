# User Database
DATABASE_URL=postgres://xflow:xflow_password@localhost:5433/xflow?sslmode=disable

# JWT Authentication
AUTH_JWT_SECRET=your-jwt-secret-here
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!

# Access-token TTL (minutes). Default 15. Replaces the deprecated
# AUTH_TOKEN_TTL_HOURS — if only the old var is set, it is converted with a
# startup warning.
AUTH_ACCESS_TTL_MINUTES=15

# Refresh-token TTL (days). Default 30. Absolute, not sliding.
AUTH_REFRESH_TTL_DAYS=30

# Feature flag for refresh-token issuance and the /auth/refresh, /auth/logout,
# /auth/logout-all endpoints. Defaults to true: the web client relies on silent
# refresh, so with this off the short-lived access token (AUTH_ACCESS_TTL_MINUTES)
# expires with no way to renew — authenticated requests and the WebSocket upgrade
# then 401 and the user is forced to re-login. Set false only for the legacy
# single-token response.
AUTH_REFRESH_ENABLED=true

# Service Authentication (for MCP-Server to API-Server communication)
SERVICE_AUTH_SECRET=your-service-auth-secret-here

# Verification Code Sending
MAILGUN_DOMAIN=your-domain.com
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_FROM="Your App <postmaster@your-domain.com>"

# Frontend and API URLs
FRONTEND_BASE_URL=http://localhost:3000
API_SERVER_URL=http://localhost:8080

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
