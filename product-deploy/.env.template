# ============================================================
# CYPRESSERA DEPLOYMENT CONFIGURATION
# ============================================================
# Only the REQUIRED section needs your input. Everything else
# either works with its default or is auto-generated by
# deploy.sh (values marked [auto]).
# ============================================================

# ============================================================
# REQUIRED — fill in these two keys
# ============================================================
# LLM API key for the AI assistant (chat + function calling).
# Any OpenAI-compatible endpoint works; see CHAT MODEL below.
OPENAI_API_KEY=

# Embedding API key for the knowledge base (RAG retrieval).
# May be the same key as OPENAI_API_KEY if your provider serves
# both chat and embedding models.
KB_EMBEDDING_API_KEY=

# ============================================================
# OPTIONAL — authentication
# ============================================================
# AUTH_MODE=password (default): email/password login. A default
#   admin account is seeded from AUTH_ADMIN_* below.
# AUTH_MODE=none: no login at all — everyone shares one local
#   workspace. Only use on localhost or a trusted network:
#   anyone who can reach the server has full access and can
#   spend your LLM API credits.
AUTH_MODE=password

# Default admin user (seeded on first startup in password mode)
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=ChangeMe123!

# Setting MAILGUN_API_KEY enables verification emails for new
# registrations. Without it, new accounts are auto-verified and
# immediately usable (fine for private instances; configure
# Mailgun if your instance is public and accepts signups).
MAILGUN_DOMAIN=flow.cypressera.ai
MAILGUN_API_KEY=
MAILGUN_FROM="CypressEra <postmaster@flow.cypressera.ai>"

# Setting both enables the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# OPTIONAL — domain & URLs
# ============================================================
# Public domain for HTTPS (Caddy obtains certificates automatically).
DOMAIN=flow.cypressera.ai

# Browser-facing URLs injected into the React UI.
# API_BASE_URL: the domain root — SDK appends /health, /api/v1/... automatically
# AGENT_BASE_URL: includes /agent prefix — Caddy strips it before forwarding
PUBLIC_API_BASE_URL=https://${DOMAIN}
PUBLIC_AGENT_BASE_URL=https://${DOMAIN}/agent

# Frontend URL for email verification redirect links
FRONTEND_BASE_URL=https://${DOMAIN}

# ============================================================
# OPTIONAL — chat model (Agent Server)
# ============================================================
# Any OpenAI-compatible API. The default uses OpenAI directly; the
# knowledge-base embeddings below also default to OpenAI, so a single
# OpenAI key can serve both required values.
#
# Alternative — OpenAI's open-weight gpt-oss-120b, served via OpenRouter
# (this model is not hosted on api.openai.com):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# ============================================================
# OPTIONAL — embedding model (Agent Server, RAG)
# ============================================================
KB_EMBEDDING_MODEL=text-embedding-3-small
KB_EMBEDDING_BASE_URL=https://api.openai.com/v1

# ============================================================
# AUTO-GENERATED — deploy.sh fills these on first run
# ============================================================
POSTGRES_USER=xflow
POSTGRES_PASSWORD=[auto]
POSTGRES_DB=xflow
# Full connection URL (uses Docker DNS — do not change the host)
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable

# Shared JWT secret — MUST be the same for both servers
AUTH_JWT_SECRET=[auto]

# Service auth secret (Agent-Server to API-Server internal calls)
SERVICE_AUTH_SECRET=[auto]
SERVICE_AUTH_ENABLED=true

# ============================================================
# ADVANCED — defaults are fine for almost everyone
# ============================================================
GIN_MODE=release
# Internal URL (Docker DNS — do not change)
API_SERVER_URL=http://api-server:8080
# Storage base path (matches the Docker volume mount)
STORAGE_BASE_PATH=/user-data

PORT=3000
AGENT_PORT=3001
APP_ENV=production

# Knowledge base settings (paths match volume mounts)
KB_BASE_PATH=/user-data/knowledge
KB_ENABLE_FILE_WATCHER=true
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=150
KB_TOP_K=3

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Which image tag to pull from ghcr.io (a git SHA pins a release)
IMAGE_TAG=latest
