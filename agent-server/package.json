{
  "name": "@xflow/agent-server",
  "version": "1.0.0",
  "description": "Agent server for XFlow - AI assistant and function calling integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "start": "tsx --max-old-space-size=4096 src/index.ts",
    "start:memory": "tsx --max-old-space-size=8192 src/index.ts",
    "start:compiled": "node --max-old-space-size=4096 dist/index.js"
  },
  "keywords": [
    "mcp",
    "openai",
    "function-calling",
    "ai",
    "power-flow"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "openai": "^4.20.0",
    "pdf-parse": "^1.1.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/winston": "^2.4.4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
